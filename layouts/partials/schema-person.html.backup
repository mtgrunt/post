{{/* Enhanced Person Schema for Author/Developer */}}
{{ if or .IsHome (eq .Section "about") }}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Miles Wallace",
  "url": "{{ .Site.BaseURL }}",
  "image": {
    "@type": "ImageObject",
    "url": "{{ "miles.png" | absURL }}",
    "width": 600,
    "height": 600
  },
  "jobTitle": "Full-Stack Developer",
  "description": "Full-stack developer from California specializing in Python, Django, PostgreSQL, and modern web technologies.",
  "knowsAbout": [
    "Python",
    "Django",
    "PostgreSQL",
    "Web Development",
    "HTML5",
    "CSS3",
    "JavaScript",
    "Database Design",
    "Backend Development",
    "Frontend Development"
  ],
  "sameAs": [
    "https://github.com/mtgrunt",
    "https://youtube.com/@modestwalrus"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressRegion": "California",
    "addressCountry": "US"
  },
  "alumniOf": {
    "@type": "EducationalOrganization",
    "name": "Self-Taught Developer"
  }
}
</script>
{{ end }}
